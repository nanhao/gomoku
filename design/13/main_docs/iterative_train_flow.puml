@startuml iterative_train_flow
title iterative_train.py 迭代训练流程

skinparam defaultFontName Microsoft YaHei,SimHei,sans-serif
skinparam backgroundColor white
skinparam shadowing false

actor "用户" as User

participant "main()" as Main
participant "argparse" as Argparse
participant "IterativeTrainer\n__init__()" as Trainer
participant "create_samples.py" as CreateSamples
participant "train_main.py" as TrainMain
participant "battle.py" as Battle
participant "文件系统" as FS

== 参数解析 ==

User -> Main: python ai/iterative_train.py\n--ai1 cnn_v4.99 --ai2 cnn_v4.100\n--sample_dir ai/merge_samples2

Main -> Argparse: parser.parse_args()
Argparse --> Main: args

== 参数校验 ==

Main -> Main: 解析 --ai1 → (model_name, gen_of_ai1)
note right: "cnn_v4.99".rsplit(".", 1)\n→ ("cnn_v4", 99)

Main -> Main: 解析 --ai2 → (_, gen_of_ai2)
note right: "cnn_v4.100".rsplit(".", 1)\n→ ("cnn_v4", 100)

Main -> Main: 校验 model_name 一致

alt model_name 不一致
    Main -> User: parser.error("模型名必须一致")\nSystemExit(2)
end

== 构造器初始化 ==

Main -> Trainer: IterativeTrainer(ai1, ai2, sample_dir)

group 计算路径
    Trainer -> Trainer: model_name = "cnn_v4"
    Trainer -> Trainer: pth_of_ai1 = ai/models/cnn_v4/gen99/cnn_v4.pth
    Trainer -> Trainer: pth_of_ai2 = ai/models/cnn_v4/gen100/cnn_v4.pth
    Trainer -> Trainer: sample_output_dir = ai/merge_samples2/v100
    Trainer -> Trainer: lock_path = ai/models/cnn_v4/.iterative_lock
end

Trainer -> Trainer: 前置校验: pth_of_ai1 存在?
alt 不存在
    Trainer -> User: FileNotFoundError
end

Trainer -> Trainer: 前置校验: lock 文件?
alt 已存在
    Trainer -> User: RuntimeError
end

Trainer --> Main: trainer 实例

== 迭代循环开始 ==

loop i = 1, 2, 3, ... (Ctrl+C 停止)

    Trainer -> Trainer: _print_round_header()
    note right: ========== 第 i 轮迭代开始 ==========

    == 步骤 2: 复制权重 ==

    Trainer -> FS: cp pth_of_ai1 → pth_of_ai2
    note right: cp gen99/cnn_v4.pth → gen100/cnn_v4.pth

    == 步骤 3: 生成样本 ==

    Trainer -> CreateSamples: subprocess: ai/create_samples.py\n--model cnn_v4.99\n--sample_games 500\n--output ai/merge_samples2/v100/path.json

    CreateSamples -> CreateSamples: cnn_v4.99 自对弈\n收集 500 局样本
    CreateSamples --> Trainer: 样本文件 path.json

    Trainer -> Trainer: _validate_samples()
    note right: 校验 JSON 解析、非空

    == 步骤 4: 训练 ==

    Trainer -> TrainMain: subprocess: ai/train_main.py\n--model cnn_v4.100\n--train-from-dir ai/merge_samples2/v100\n--epochs 300 --batch-size 4096 --shuffle

    TrainMain -> TrainMain: 加载 cnn_v4.100 权重 (来自 gen99 副本)\n300 epochs 训练
    TrainMain --> Trainer: 训练完成

    == 步骤 5: 对战评估 ==

    Trainer -> Battle: subprocess: ai/battle.py\n--ai1 cnn_v4.99 --ai2 cnn_v4.100\n--games 100 --temp-moves 2 --temperature 2

    Battle -> Battle: cnn_v4.99 vs cnn_v4.100\n100 局对战
    Battle --> Trainer: stdout (含胜率统计)

    Trainer -> Trainer: _parse_battle_output(stdout)
    note right: 动态正则: re.escape("cnn_v4.100")\n提取胜场/胜率

    Trainer -> User: cnn_v4.99 胜 X | cnn_v4.100 胜 Y | 平局 Z | 胜率 W% | i=N

    == 步骤 6: 晋升 ==

    Trainer -> FS: mv pth_of_ai2 → pth_of_ai1
    note right: mv gen100/cnn_v4.pth → gen99/cnn_v4.pth\n(无条件晋升)

    Trainer -> Trainer: i++

end

== 用户中断 ==

User -> Trainer: Ctrl+C
Trainer -> Trainer: _print_final_report()
Trainer -> User: 最终统计报告

@enduml
