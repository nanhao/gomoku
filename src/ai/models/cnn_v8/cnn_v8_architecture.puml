@startuml
!theme plain

skinparam defaultFontName Consolas,Microsoft YaHei,sans-serif
skinparam componentFontName Consolas,Microsoft YaHei,sans-serif

skinparam rectangleBorderColor #4A90D9
skinparam rectangleBackgroundColor #F0F5FF
skinparam arrowColor #333333
skinparam noteBorderColor #E6A817
skinparam noteBackgroundColor #FFFDE7

title CNN v8 — Dual-Head Residual CNN with FC Hidden Layers (≈82K params)

' ═══════════════════════════════════════════════════════════
'  INPUT
' ═══════════════════════════════════════════════════════════

rectangle "**Input**\n(batch, 3, 15, 15)" as input #E8F5E9

' ═══════════════════════════════════════════════════════════
'  CONV BLOCK 1
' ═══════════════════════════════════════════════════════════

rectangle "**Conv1**\nConv2d(3→32, k=3, p=1)\n(batch, 32, 15, 15)" as conv1 #D6EAF8
rectangle "**BN1**\nBatchNorm2d(32)" as bn1 #D6EAF8
rectangle "**ReLU1**" as relu1 #D6EAF8

input -down-> conv1
conv1 -down-> bn1
bn1 -down-> relu1

' ═══════════════════════════════════════════════════════════
'  RESIDUAL BLOCK 1
' ═══════════════════════════════════════════════════════════

package "Residual Block 1" as rb1 #FDEBD0 {
    rectangle "**Conv2**\nConv2d(32→32, k=3, p=1)" as conv2 #FADBD8
    rectangle "**BN2**\nBatchNorm2d(32)" as bn2 #FADBD8
    rectangle "**ReLU2**" as relu2 #FADBD8
    rectangle "**Conv3**\nConv2d(32→32, k=3, p=1)" as conv3 #FADBD8
    rectangle "**BN3**\nBatchNorm2d(32)" as bn3 #FADBD8
    
    conv2 -down-> bn2
    bn2 -down-> relu2
    relu2 -down-> conv3
    conv3 -down-> bn3
}

relu1 -down-> conv2
relu1 -down-> bn3 : shortcut\n(identity)

rectangle "**⊕ Add + ReLU3**\n(batch, 32, 15, 15)" as merge1 #D5F5E3

bn3 -down-> merge1

' ═══════════════════════════════════════════════════════════
'  RESIDUAL BLOCK 2
' ═══════════════════════════════════════════════════════════

package "Residual Block 2" as rb2 #FDEBD0 {
    rectangle "**Conv4**\nConv2d(32→32, k=3, p=1)" as conv4 #FADBD8
    rectangle "**BN4**\nBatchNorm2d(32)" as bn4 #FADBD8
    rectangle "**ReLU4**" as relu4 #FADBD8
    rectangle "**Conv5**\nConv2d(32→32, k=3, p=1)" as conv5 #FADBD8
    rectangle "**BN5**\nBatchNorm2d(32)" as bn5 #FADBD8
    
    conv4 -down-> bn4
    bn4 -down-> relu4
    relu4 -down-> conv5
    conv5 -down-> bn5
}

merge1 -down-> conv4
merge1 -down-> bn5 : shortcut\n(identity)

rectangle "**⊕ Add + ReLU5**\nShared Features\n(batch, 32, 15, 15)" as merge2 #D5F5E3

bn5 -down-> merge2

' ═══════════════════════════════════════════════════════════
'  POLICY HEAD
' ═══════════════════════════════════════════════════════════

package "Policy Head" as policy_block #EBDEF0 {
    rectangle "**Conv_out**\nConv2d(32→1, k=1)\n(batch, 1, 15, 15)" as p_conv #D2B4DE
    rectangle "**Flatten**\n(batch, 225)" as p_flatten #D2B4DE
    rectangle "**FC1**\nLinear(225→64)" as p_fc1 #D2B4DE
    rectangle "**ReLU**" as p_relu #D2B4DE
    rectangle "**FC2**\nLinear(64→225)" as p_fc2 #D2B4DE
    rectangle "**LogSoftmax**(dim=1)\n(batch, 225)" as p_logsoftmax #D2B4DE
    
    p_conv -down-> p_flatten
    p_flatten -down-> p_fc1
    p_fc1 -down-> p_relu
    p_relu -down-> p_fc2
    p_fc2 -down-> p_logsoftmax
}

' ═══════════════════════════════════════════════════════════
'  VALUE HEAD
' ═══════════════════════════════════════════════════════════

package "Value Head" as value_block #A9CCE3 {
    rectangle "**Value_Conv_out**\nConv2d(32→1, k=1)\n(batch, 1, 15, 15)" as v_conv #85C1E9
    rectangle "**Flatten**\n(batch, 225)" as v_flatten #85C1E9
    rectangle "**FC1**\nLinear(225→64)" as v_fc1 #85C1E9
    rectangle "**ReLU**" as v_relu #85C1E9
    rectangle "**FC2**\nLinear(64→1)" as v_fc2 #85C1E9
    rectangle "**Tanh**\n(batch, 1) ∈ [-1, 1]" as v_tanh #85C1E9
    
    v_conv -down-> v_flatten
    v_flatten -down-> v_fc1
    v_fc1 -down-> v_relu
    v_relu -down-> v_fc2
    v_fc2 -down-> v_tanh
}

merge2 -down-> p_conv
merge2 -down-> v_conv

' ═══════════════════════════════════════════════════════════
'  OUTPUT
' ═══════════════════════════════════════════════════════════

rectangle "**Output: (policy, value)**\npolicy: 225-dim move probabilities\nvalue: scalar win-rate ∈ [-1, 1]" as output #E8F5E9

p_logsoftmax -down-> output
v_tanh -down-> output

' ═══════════════════════════════════════════════════════════
'  NOTES
' ═══════════════════════════════════════════════════════════

note right of rb1
  Residual connection:
  output = ReLU(Conv3(…)+input)
end note

note right of rb2
  Two stacked residual blocks
  for deeper feature extraction.
end note

note right of policy_block
  ↓ vs cnn_v7: added
  FC(225→64)+ReLU layer
  for better policy modeling.
  
  Params: 225×64+64×225
  ≈ 28.9K new
end note

note right of value_block
  ↓ vs cnn_v7: added
  FC(225→64)+ReLU layer,
  removed Flatten→ReLU.
  
  Total value params
  ≈ 14.5K new
end note

@enduml
